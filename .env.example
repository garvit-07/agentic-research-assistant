# ---- LLM ----
LLM_PROVIDER=openai          # openai | anthropic | any provider supported by langchain init_chat_model
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
OPENAI_API_KEY=sk-your-key
# ANTHROPIC_API_KEY=            # if LLM_PROVIDER=anthropic (pip install langchain-anthropic)

# ---- Embeddings (document retrieval) ----
EMBEDDING_PROVIDER=openai    # openai | fake (offline/testing only)
EMBEDDING_MODEL=text-embedding-3-small

# ---- Web search ----
# Leave empty to use DuckDuckGo (no key needed). Set to use Tavily.
TAVILY_API_KEY=

# ---- Agent behaviour ----
MAX_PLAN_STEPS=4
MAX_TOOL_ROUNDS=3
MAX_REVISIONS=2
MIN_REVIEW_SCORE=7
HISTORY_WINDOW=6

# ---- API ----
API_KEY=                     # if set, clients must send header X-API-Key
LOG_LEVEL=INFO
DATA_DIR=data
